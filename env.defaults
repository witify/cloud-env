APP_NAME="__APP_TITLE__"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=__SITE_URL__
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4
DEBUGBAR_ENABLED=false
NIGHTWATCH_ENABLED=false
TELESCOPE_ENABLED=false
BOOST_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__APP_DATABASE__
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=cloud@example.test
MAIL_FROM_NAME="${APP_NAME}"

# Not a key. Outside tests, an app can geocode addresses during its seed: Google answers 403
# with no key at all, which stops the seed, and 200 REQUEST_DENIED with a bad one, which does not.
GOOGLE_SECRET=cloud-placeholder-not-a-key

# Not keys. Some apps read the Pusher key in the browser at import, and a null key leaves a blank page.
PUSHER_APP_ID=cloud-only
PUSHER_APP_KEY=cloud-only
PUSHER_APP_SECRET=cloud-only
PUSHER_HOST=localhost
PUSHER_PORT=8080
PUSHER_SCHEME=http
