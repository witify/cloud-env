#!/usr/bin/env python3
"""Prints the state of CI and Codex on the last commit of a pull request, once, without waiting.

    pr-status <pull request number>

The pull request is watched by Claude's native autofix (`subscribe_pr_activity`): CI results,
Codex reviews and people's comments wake the session. This command only reads, at each wake, what
an event does not say in full: whether every check run of the last commit passed, and whether
Codex approved that commit, which it often says with a thumbs up or the state line of its summary
comment.

Codex shows a sign within seconds when it reviews a commit: with no sign of it on a commit older
than 5 minutes, the repository has no Codex review (`absent`), and before that it is `waiting`.

Exit 0: the state was read. Exit 2: the pull request could not be read."""
import datetime
import json
import re
import subprocess
import sys
import time

QUIET_MINUTES = 5
PASSED_CONCLUSIONS = ('success', 'neutral', 'skipped')
NO_REVIEW_OF_THIS_COMMIT = ('absent', 'older-commit')
CODEX_STATE = re.compile(r'codex-review-state:v\d+\s+(\{.*?\})\s*-->', re.DOTALL)


class GitHubError(Exception):
    pass


def github(path):
    result = subprocess.run(['gh', 'api', path], capture_output=True, text=True, timeout=60)
    if result.returncode != 0:
        raise GitHubError(result.stderr.strip()[:300] or f'gh api {path} failed')
    try:
        return json.loads(result.stdout)
    except ValueError as error:
        raise GitHubError(f'gh api {path} did not answer JSON') from error


def repository():
    url = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True).stdout.strip()
    match = re.search(r'[:/]([\w.-]+)/([\w.-]+?)(\.git)?/?$', url)
    if not match:
        raise GitHubError('the origin remote is not a GitHub repository')
    return f'{match.group(1)}/{match.group(2)}'


def timestamp(value):
    return datetime.datetime.fromisoformat(value.replace('Z', '+00:00')).timestamp()


def is_codex(user):
    return 'codex' in ((user or {}).get('login') or '').lower()


def ci_state(repo, sha):
    runs = github(f'repos/{repo}/commits/{sha}/check-runs?per_page=100').get('check_runs') or []
    if not runs:
        return 'none', 'no check run on this commit'

    pending = sorted({run.get('name', '?') for run in runs if run.get('status') != 'completed'})
    failed = sorted({run.get('name', '?') for run in runs
                     if run.get('status') == 'completed' and run.get('conclusion') not in PASSED_CONCLUSIONS})
    if pending:
        return 'pending', ', '.join(pending)
    if failed:
        return 'failed', ', '.join(failed)
    return 'passed', f'{len(runs)} checks'


def codex_summary(comments):
    """The state line Codex keeps in its summary comment, or None."""
    for comment in reversed(comments):
        match = is_codex(comment.get('user')) and CODEX_STATE.search(comment.get('body') or '')
        if match:
            try:
                return json.loads(match.group(1)).get('code_review') or {}
            except ValueError:
                return None
    return None


def codex_state(repo, number, sha, committed):
    # Codex puts a new thumbs up at each approval: one older than the last commit is for an older commit.
    reactions = {reaction.get('content') for reaction in github(f'repos/{repo}/issues/{number}/reactions?per_page=100')
                 if is_codex(reaction.get('user'))
                 and (reaction.get('content') != '+1' or timestamp(reaction.get('created_at') or '1970-01-01T00:00:00Z') >= committed)}
    comments = github(f'repos/{repo}/issues/{number}/comments?per_page=100')
    reviews = [review for review in github(f'repos/{repo}/pulls/{number}/reviews?per_page=100') if is_codex(review.get('user'))]
    summary = codex_summary(comments)

    if any(review.get('commit_id') == sha for review in reviews):
        return 'findings', 'a review on this commit'

    if summary and summary.get('status') == 'completed':
        reviewed = summary.get('commit_sha') or ''
        if reviewed != sha and 'eyes' in reactions:
            return 'reviewing', f'no answer yet, its last answer is for {reviewed[:7]}'
        if reviewed != sha:
            return 'older-commit', f'its last answer is for {reviewed[:7]}, not for this commit'
        if summary.get('has_any_findings'):
            return 'findings', 'its summary comment names findings'
        return 'approved', 'no finding on this commit'

    if summary or 'eyes' in reactions:
        return 'reviewing', 'no answer yet'
    if '+1' in reactions:
        return 'approved', 'a thumbs up after the last commit'
    if reviews:
        return 'older-commit', 'its last review is for an older commit'
    return 'absent', 'no reaction, comment or review from Codex for this commit'


def read(repo, number):
    pull = github(f'repos/{repo}/pulls/{number}')
    sha = pull['head']['sha']
    state = 'merged' if pull.get('merged') else pull.get('state') or 'open'
    committed = timestamp(github(f'repos/{repo}/commits/{sha}')['commit']['committer']['date'])
    codex = codex_state(repo, number, sha, committed)
    age = (time.time() - committed) / 60
    if codex[0] in NO_REVIEW_OF_THIS_COMMIT and age < QUIET_MINUTES:
        codex = 'waiting', f'no sign yet, the last commit is {int(age)} minutes old ({codex[1]})'
    return sha, state, ci_state(repo, sha), codex


def main():
    arguments = sys.argv[1:]
    if len(arguments) != 1 or not arguments[0].isdigit():
        print('Usage: pr-status <pull request number>', file=sys.stderr)
        return 2
    number = arguments[0]

    try:
        repo = repository()
        sha, state, ci, codex = read(repo, number)
    except (GitHubError, KeyError, TypeError, ValueError, AttributeError, OSError, subprocess.TimeoutExpired) as error:
        print(f'pr-status: the pull request could not be read: {error}', file=sys.stderr)
        return 2

    print(f'pull request: {repo}#{number}, commit {sha[:7]}' + ('' if state == 'open' else f', {state}'))
    print(f'ci: {ci[0]} ({ci[1]})')
    print(f'codex: {codex[0]} ({codex[1]})')
    return 0


if __name__ == '__main__':
    sys.exit(main())
