#!/usr/bin/env python3
"""Prints the state of CI and Codex on the last commit of a pull request.

    pr-status <pull request number>
    pr-status <pull request number> --wait [--minutes 15]

The pull request is watched by Claude's native autofix (`subscribe_pr_activity`): CI results,
Codex reviews and people's comments wake the session. Without `--wait`, this command reads once,
at each wake, what an event does not say in full: whether every check run of the last commit
passed, and whether Codex approved that commit, which it often says with a thumbs up or the state
line of its summary comment.

With `--wait`, it reads every 20 seconds until CI is no longer pending and Codex has answered for
that commit, or shows no sign of it once the quiet window has passed. It also stops when the pull
request is no longer open, or `--minutes` after this call started. It exists for the gaps no event
fills: a thumbs up from Codex sends no event, and nothing marks the end of the quiet window. It is
also the loop of phase 1, in the turn that opens the pull request.

The last commit counts as pushed at the latest of its committer date, the creation of the pull
request and the first check suite of that commit. Codex shows a sign within seconds when it
reviews a commit: with no sign of it 5 minutes after the push, the repository has no Codex review
(`absent`), or its last answer is for an older commit (`older-commit`), and before that it is
`waiting`. A thumbs up counts as an approval only when it is newer than the push and Codex has no
summary comment: with a summary comment, only one for the last commit approves it.

Exit 0: the state was read, and with `--wait`, CI and Codex are both known. Exit 1, with `--wait`
only: the time ran out, or the pull request is closed or merged, and the lines say what is still
pending. Exit 2: the pull request could not be read."""
import datetime
import json
import re
import subprocess
import sys
import time

POLL_SECONDS = 20
DEFAULT_MINUTES = 15.0
QUIET_MINUTES = 5
FAILED_READS_ALLOWED = 3
PASSED_CONCLUSIONS = ('success', 'neutral', 'skipped')
ANSWERED = ('approved', 'findings')
NO_REVIEW_OF_THIS_COMMIT = ('absent', 'older-commit')
CODEX_STATE = re.compile(r'codex-review-state:v\d+\s+(\{.*?\})\s*-->', re.DOTALL)
USAGE = 'Usage: pr-status <pull request number> [--wait [--minutes 15]]'


class GitHubError(Exception):
    pass


# A failed answer from GitHub: a wait tolerates a few in a row.
READ_FAILURES = (GitHubError, subprocess.TimeoutExpired)
# Anything that keeps the state from being read.
UNREADABLE = (GitHubError, KeyError, TypeError, ValueError, AttributeError, OSError, subprocess.TimeoutExpired)


def github(path, pages=False):
    """The JSON answer of `gh api <path>`, or with `pages` the list of all its pages."""
    command = ['gh', 'api', '--paginate', '--slurp', path] if pages else ['gh', 'api', path]
    result = subprocess.run(command, capture_output=True, text=True, timeout=60)
    if result.returncode != 0:
        raise GitHubError(result.stderr.strip()[:300] or f'gh api {path} failed')
    try:
        return json.loads(result.stdout)
    except ValueError as error:
        raise GitHubError(f'gh api {path} did not answer JSON') from error


def github_list(path):
    """Every item of a list that GitHub returns in pages."""
    return [item for page in github(path, pages=True) for item in page]


def repository():
    url = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True).stdout.strip()
    match = re.search(r'[:/]([\w.-]+)/([\w.-]+?)(\.git)?/?$', url)
    if not match:
        raise GitHubError('the origin remote is not a GitHub repository')
    return f'{match.group(1)}/{match.group(2)}'


def timestamp(value):
    return datetime.datetime.fromisoformat(value.replace('Z', '+00:00')).timestamp()


def is_codex(user):
    return 'codex' in ((user or {}).get('login') or '').lower()


def pushed_at(repo, pull, sha):
    """When the last commit reached the pull request: the latest of its committer date, the creation
    of the pull request and the first check suite of the commit. A commit made long before its push
    is as new to Codex as the push."""
    moments = [timestamp(github(f'repos/{repo}/commits/{sha}')['commit']['committer']['date'])]
    if pull.get('created_at'):
        moments.append(timestamp(pull['created_at']))
    try:
        pages = github(f'repos/{repo}/commits/{sha}/check-suites?per_page=100', pages=True)
        created = [timestamp(suite['created_at']) for page in pages for suite in page.get('check_suites') or []
                   if suite.get('created_at')]
        if created:
            moments.append(min(created))
    except UNREADABLE:
        pass  # The other two moments are enough.
    return max(moments)


def ci_state(repo, sha):
    pages = github(f'repos/{repo}/commits/{sha}/check-runs?per_page=100', pages=True)
    runs = [run for page in pages for run in page.get('check_runs') or []]
    total = (pages[0].get('total_count') or 0) if pages else 0
    if total > len(runs):
        return 'pending', f'not all check runs read: {len(runs)} of {total}'
    if not runs:
        return 'none', 'no check run on this commit'

    pending = sorted({run.get('name', '?') for run in runs if run.get('status') != 'completed'})
    failed = sorted({run.get('name', '?') for run in runs
                     if run.get('status') == 'completed' and run.get('conclusion') not in PASSED_CONCLUSIONS})
    if pending:
        return 'pending', ', '.join(pending)
    if failed:
        return 'failed', ', '.join(failed)
    return 'passed', f'{len(runs)} checks'


def codex_summary(comments):
    """The state line Codex keeps in its summary comment ({} when it cannot be read), or None when
    Codex wrote no summary comment."""
    for comment in reversed(comments):
        match = is_codex(comment.get('user')) and CODEX_STATE.search(comment.get('body') or '')
        if match:
            try:
                return json.loads(match.group(1)).get('code_review') or {}
            except (ValueError, AttributeError):
                return {}
    return None


def codex_state(repo, number, sha, pushed):
    # Codex puts a new thumbs up at each approval: one older than the push is for an older commit.
    reactions = {reaction.get('content') for reaction in github_list(f'repos/{repo}/issues/{number}/reactions?per_page=100')
                 if is_codex(reaction.get('user'))
                 and (reaction.get('content') != '+1' or timestamp(reaction.get('created_at') or '1970-01-01T00:00:00Z') >= pushed)}
    comments = github_list(f'repos/{repo}/issues/{number}/comments?per_page=100')
    reviews = [review for review in github_list(f'repos/{repo}/pulls/{number}/reviews?per_page=100') if is_codex(review.get('user'))]
    summary = codex_summary(comments)

    if any(review.get('commit_id') == sha for review in reviews):
        return 'findings', 'a review on this commit'

    # With a summary comment, only its state line can approve the last commit, never a thumbs up alone.
    if summary is not None:
        reviewed = summary.get('commit_sha') or ''
        if summary.get('status') != 'completed' or (reviewed != sha and 'eyes' in reactions):
            return 'reviewing', 'no answer yet' + (f', its last answer is for {reviewed[:7]}' if reviewed and reviewed != sha else '')
        if reviewed != sha:
            return 'older-commit', f'its last answer is for {reviewed[:7]}, not for this commit'
        if summary.get('has_any_findings'):
            return 'findings', 'its summary comment names findings'
        return 'approved', 'no finding on this commit'

    if 'eyes' in reactions:
        return 'reviewing', 'no answer yet'
    if '+1' in reactions:
        return 'approved', 'a thumbs up after the push of the last commit'
    if reviews:
        return 'older-commit', 'its last review is for an older commit'
    return 'absent', 'no reaction, comment or review from Codex for this commit'


def read(repo, number):
    pull = github(f'repos/{repo}/pulls/{number}')
    sha = pull['head']['sha']
    state = 'merged' if pull.get('merged') else pull.get('state') or 'open'
    pushed = pushed_at(repo, pull, sha)
    codex = codex_state(repo, number, sha, pushed)
    age = (time.time() - pushed) / 60
    if codex[0] in NO_REVIEW_OF_THIS_COMMIT and age < QUIET_MINUTES:
        codex = 'waiting', f'no sign yet, the last commit was pushed {int(age)} min ago ({codex[1]})'
    return sha, state, ci_state(repo, sha), codex


def known(ci, codex):
    """CI is done and Codex answered, or showed no sign once the quiet window passed."""
    return ci[0] != 'pending' and (codex[0] in ANSWERED or codex[0] in NO_REVIEW_OF_THIS_COMMIT)


def wait(repo, number, minutes):
    """Reads until CI and Codex are known, the pull request is not open, or the time runs out.
    Returns the last state read and why it stopped: 'known', 'not open' or 'late'."""
    began = time.monotonic()
    last, failed_reads = None, 0
    while True:
        try:
            last = read(repo, number)
            failed_reads = 0
        except READ_FAILURES:
            # One failed answer in a long wait is not the end of it, but a failed first read is.
            failed_reads += 1
            if last is None or failed_reads > FAILED_READS_ALLOWED:
                raise
        else:
            if last[1] != 'open':
                return last, 'not open'
            if known(last[2], last[3]):
                return last, 'known'
        if time.monotonic() - began >= minutes * 60:
            return last, 'late'
        time.sleep(POLL_SECONDS)


def parse(arguments):
    """(number, wait, minutes), or None for a wrong call."""
    arguments = list(arguments)
    waits = '--wait' in arguments
    if waits:
        arguments.remove('--wait')
    minutes = DEFAULT_MINUTES
    if '--minutes' in arguments:
        index = arguments.index('--minutes')
        try:
            minutes = float(arguments[index + 1])
        except (IndexError, ValueError):
            return None
        del arguments[index:index + 2]
        if not waits or not minutes > 0:
            return None
    if len(arguments) != 1 or not arguments[0].isdigit():
        return None
    return arguments[0], waits, minutes


def main():
    call = parse(sys.argv[1:])
    if call is None:
        print(USAGE, file=sys.stderr)
        return 2
    number, waits, minutes = call
    began = time.monotonic()

    try:
        repo = repository()
        if waits:
            (sha, state, ci, codex), outcome = wait(repo, number, minutes)
        else:
            (sha, state, ci, codex), outcome = read(repo, number), None
    except UNREADABLE as error:
        print(f'pr-status: the pull request could not be read: {error}', file=sys.stderr)
        return 2

    print(f'pull request: {repo}#{number}, commit {sha[:7]}' + ('' if state == 'open' else f', {state}'))
    print(f'ci: {ci[0]} ({ci[1]})')
    print(f'codex: {codex[0]} ({codex[1]})')
    if not waits:
        return 0
    print(f'waited: {int(time.monotonic() - began)} s'
          + (f', the time ran out after {minutes:g} min' if outcome == 'late' else ''))
    return 0 if outcome == 'known' else 1


if __name__ == '__main__':
    sys.exit(main())
